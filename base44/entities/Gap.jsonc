{
  "name": "Gap",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "enum": [
        "פארן",
        "בשור",
        "צין",
        "רמון",
        "תמר"
      ],
      "title": "פלוגה",
      "description": "הפלוגה האחראית לפער"
    },
    "gap": {
      "type": "string",
      "title": "תיאור הפער",
      "description": "תיאור הליקוי או המשימה"
    },
    "location": {
      "type": "string",
      "enum": [
        "מגורים כללי",
        "מגורי בנים",
        "מגורי בנות",
        "כיתות",
        "ספסלים",
        "שולחנות ספרייה",
        "פינת פריסה",
        "פינת קקס",
        "שביל",
        "פינת עישון",
        "כניסה למגורי בנים",
        "כניסה למגורי בנות",
        "רחבת רמון",
        "פינת ישיבה מאחורי הקמנים",
        "דקצו",
        "איזור שקם",
        "מתחם קמנים חיצוני",
        "שבילים מקיפי מתחם קמנים",
        "שביל צמוד למדרכה",
        "דשא כניסה למתחם",
        "פינת גלחצ"
      ],
      "title": "מיקום",
      "description": "מיקום הפער בפרויקט"
    },
    "building": {
      "type": "string",
      "title": "מבנה",
      "description": "מבנה (למגורים/כיתות בלבד)"
    },
    "room_number": {
      "type": "string",
      "title": "מספר חדר",
      "description": "מספר חדר (למגורים/כיתות בלבד)"
    },
    "status": {
      "type": "string",
      "enum": [
        "טרם הועלה",
        "בטיפול",
        "טופל"
      ],
      "default": "טרם הועלה",
      "title": "סטטוס"
    },
    "priority": {
      "type": "string",
      "enum": [
        "נמוך",
        "בינוני",
        "גבוה",
        "קריטי"
      ],
      "default": "בינוני",
      "title": "עדיפות חשיבות"
    },
    "opened_at": {
      "type": "string",
      "format": "date",
      "title": "תאריך פתיחה"
    },
    "opened_by_name": {
      "type": "string",
      "title": "שם הפותח",
      "description": "שם מי שפתח את הפער"
    },
    "opened_by_phone": {
      "type": "string",
      "title": "טלפון הפותח",
      "description": "מספר טלפון של מי שפתח את הפער"
    },
    "note": {
      "type": "string",
      "title": "הערות"
    }
  },
  "required": [
    "company",
    "gap",
    "opened_by_name",
    "opened_by_phone"
  ]
}
