{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc",
      "format": "email"
    },
    "full_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "assigned_role": {
      "type": "string",
      "enum": [
        "\u05e7\u05dc\u05e4",
        "\u05e8\u05e1\u05e8",
        "\u05e1\u05d2\u05dc",
        "admin"
      ],
      "title": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}