{
  "name": "DailySummary",
  "type": "object",
  "properties": {
    "summary_date": {
      "type": "string",
      "title": "תאריך"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "pluga": {
            "type": "string",
            "enum": [
              "פארן",
              "בשור",
              "צין",
              "רמון",
              "תמר"
            ],
            "title": "פלוגה רלוונטית"
          },
          "building": {
            "type": "string",
            "title": "מבנה"
          },
          "room_number": {
            "type": "string",
            "title": "מספר חדר"
          }
        }
      },
      "title": "פרטי הסיכום"
    }
  },
  "required": [
    "summary_date"
  ]
}
